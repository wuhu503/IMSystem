# 行尾统一策略：仓库内一律以 LF 存储，检出时再由 Git 按平台还原。
# 之前 .cpp/.h/.ui 里 LF 与 CRLF 混用，会让 diff 出现整文件改动。
* text=auto

# 明确文本类型，便于按语言高亮 diff
*.cpp          text diff=cpp
*.h            text diff=cpp
*.ui           text
*.qrc          text
*.sql          text
*.md           text
*.txt          text
CMakeLists.txt text
.gitattributes text
.gitignore     text

# 二进制文件不做行尾转换
*.db    binary
*.db-wal binary
*.db-shm binary
*.png   binary
*.ico   binary
*.exe   binary
*.dll   binary
